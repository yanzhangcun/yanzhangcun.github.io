---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | strip_html | normalize_whitespace | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/rss+xml" />
    <language>{{ site.lang | default: "en" }}</language>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>

    {% assign feed_posts = site.posts | where_exp: "post", "post.sitemap != false" %}
    {% for post in feed_posts limit:10 %}
    {% assign post_url = post.url | prepend: site.baseurl | prepend: site.url %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <description>
        {{ post.excerpt | default: post.content | strip_html | normalize_whitespace | truncate: 300 | xml_escape }}
      </description>
      <content:encoded><![CDATA[
        {{ post.content | replace: 'src="/', 'src="' | replace: 'href="/', 'href="' }}
      ]]></content:encoded>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      {% if post.last_modified_at %}
      <lastBuildDate>{{ post.last_modified_at | date_to_rfc822 }}</lastBuildDate>
      {% endif %}
      <link>{{ post_url }}</link>
      <guid isPermaLink="true">{{ post_url }}</guid>
      {% if post.author or site.author %}
      <author>{{ site.email }} ({{ post.author | default: site.author | xml_escape }})</author>
      {% endif %}
      {% assign all_categories = post.tags | concat: post.categories | uniq %}
      {% for category in all_categories %}
      <category>{{ category | xml_escape }}</category>
      {% endfor %}
    </item>
    {% endfor %}
  </channel>
</rss>
